# Image legere Node.js pour le developpement.
FROM node:20-alpine

WORKDIR /app

# Copie les fichiers de dependances.
COPY package*.json ./

# Installe les dependances du projet.
RUN npm ci

# Copie le code source dans le conteneur.
COPY . .

EXPOSE 5173

# Lance Vite en ecoute reseau pour acces depuis le navigateur.
CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "5173"]
