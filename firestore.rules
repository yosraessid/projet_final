rules_version = '2';

// Regles Firestore pour Projet_final
// IMPORTANT: copier ce fichier dans Firebase Console > Firestore > Regles > Publier

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // --- Profils utilisateurs ---
    match /users/{userId} {
      // Lecture: utilisateur connecte (liste des membres, recherche par email)
      allow read: if isSignedIn();

      // Ecriture: uniquement son propre profil
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // --- Groupes / projets ---
    match /projects/{projectId} {
      // Lecture: seulement les projets dont on est membre
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.memberUids;

      // Creation: le createur doit s inclure dans memberUids
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids is list
        && request.resource.data.name is string;

      allow update, delete: if isSignedIn()
        && request.auth.uid in resource.data.memberUids;

      // --- Taches d un projet ---
      match /tasks/{taskId} {
        allow read, write: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberUids;
      }
    }
  }
}
