rules_version = '2';

// ATTENTION: regles TEMPORAIRES pour debuter / tester uniquement.
// Tout utilisateur connecte peut lire et ecrire partout.
// Ne jamais laisser ces regles en production.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
